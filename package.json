{
  "name": "dnd-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "npm run build:server && node --enable-source-maps dist/apps/server/src/index.js",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p apps/server/tsconfig.build.json && node scripts/copy-server-assets.mjs",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "start": "node --enable-source-maps dist/apps/server/src/index.js",
    "typecheck": "tsc -p apps/server/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "locales:audit": "node scripts/audit-locales.ts",
    "content:audit": "node --conditions=source scripts/audit-content.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/crimson-pro": "5.3.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "@nestjs/platform-socket.io": "12.3.2",
    "@nestjs/websockets": "12.3.2",
    "i18next": "26.5.11",
    "minisearch": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.20",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "imports": {
    "#shared/*": {
      "source": "./packages/shared/src/*.ts",
      "default": "./dist/packages/shared/src/*.js"
    },
    "#content/*": {
      "source": "./packages/content/src/*.ts",
      "default": "./dist/packages/content/src/*.js"
    },
    "#rules/*": {
      "source": "./packages/rules/src/*.ts",
      "default": "./dist/packages/rules/src/*.js"
    }
  }
}
